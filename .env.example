# Config for `docker compose up` (root docker-compose.yml). Copy to .env and edit:
#   cp .env.example .env

POSTGRES_USER=car_rental
POSTGRES_PASSWORD=orlandojr1210
POSTGRES_DB=car_rental

# Required - the backend refuses to start in production mode with a default key.
SECRET_KEY=change-this-to-a-random-secret

# Browser-facing origin the frontend is actually reached at.
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Only set to true once everything is served over HTTPS (e.g. behind a TLS proxy) -
# browsers drop secure cookies silently over plain HTTP, which breaks login.
SESSION_COOKIE_SECURE=false
