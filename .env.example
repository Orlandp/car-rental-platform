# Config for `docker compose up` (root docker-compose.yml). Copy to .env and edit:
#   cp .env.example .env

POSTGRES_USER=car_rental
POSTGRES_PASSWORD=orlandojr1210
POSTGRES_DB=car_rental

# Required - the backend refuses to start in production mode with a default key.
SECRET_KEY=change-this-to-a-random-secret

# Browser-facing origin the frontend is actually reached at.
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Host port the frontend is published on. Change this (and CORS_ORIGINS/
# FRONTEND_URL above to match) if 8080 is already taken on this host, e.g. by
# another app's proxy.
FRONTEND_PORT=8080

# db/backend are bound to 127.0.0.1 only (see docker-compose.yml) - these just
# control which localhost port they land on, for the rare case 5433/5000 clash
# with something else already on the host. Not reachable from outside either way.
# DB_HOST_PORT=5433
# BACKEND_HOST_PORT=5000

# Only set to true once everything is served over HTTPS (e.g. behind a TLS proxy) -
# browsers drop secure cookies silently over plain HTTP, which breaks login.
SESSION_COOKIE_SECURE=false

# M-Pesa / Daraja (STK Push) - from your app at developer.safaricom.co.ke/dashboard/myapps
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# Public HTTPS URL Safaricom POSTs the payment result to - required, STK pushes
# never resolve without it, e.g. https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=
