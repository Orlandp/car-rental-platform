FLASK_APP=run.py
FLASK_ENV=development
# Enables Flask's debugger/auto-reload for `python run.py`. Leave unset (or 0) in
# production - app startup also refuses to run with the default SECRET_KEY once
# FLASK_ENV=production.
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_rental_dev
# Comma-separated list of origins allowed to call the API with credentials (React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Auto-true when FLASK_ENV=production; override explicitly if needed.
# SESSION_COOKIE_SECURE=true

# M-Pesa / Daraja (STK Push) - from your app at developer.safaricom.co.ke/dashboard/myapps
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is Safaricom's shared sandbox shortcode; the default MPESA_PASSKEY in
# config.py is its matching public sandbox passkey, so both can stay unset here
# for sandbox testing. Set both to your own paybill/till + passkey for
# MPESA_ENV=production.
MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# Public HTTPS URL Safaricom POSTs the payment result to - required, STK
# pushes never resolve without it. Must be reachable from the internet, e.g.
# https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=
