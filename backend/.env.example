FLASK_APP=run.py
FLASK_ENV=development
# Enables Flask's debugger/auto-reload for `python run.py`. Leave unset (or 0) in
# production - app startup also refuses to run with the default SECRET_KEY once
# FLASK_ENV=production.
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_rental_dev
# Comma-separated list of origins allowed to call the API with credentials (React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Auto-true when FLASK_ENV=production; override explicitly if needed.
# SESSION_COOKIE_SECURE=true
